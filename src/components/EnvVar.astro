---
/**
 * EnvVar — formatted environment-variable reference with copy support.
 *
 * Reads default + required from props; the env-vars reference page
 * lists every variable with this same component for one-line cross
 * referencing from selfhost runbooks.
 */
interface Props {
  name: string;
  default?: string;
  required?: boolean;
}
const { name, default: defaultValue, required = false } = Astro.props;
---

<span class="env-var" data-required={required ? "true" : "false"}>
  <code class="env-name">{name}</code>
  {
    defaultValue !== undefined && (
      <span class="env-default" aria-label="default value">
        = <code>{defaultValue}</code>
      </span>
    )
  }
  {required && <span class="env-required" aria-label="required">required</span>}
</span>

<style>
  .env-var {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.0625rem 0.5rem;
    background: oklch(from var(--sl-color-accent, var(--primary)) l c h / 0.06);
    border: 1px solid
      oklch(from var(--sl-color-accent, var(--primary)) l c h / 0.18);
    border-radius: 0.375rem;
    font-size: 0.85em;
    line-height: 1.6;
    white-space: nowrap;
  }

  .env-name {
    background: transparent;
    color: var(--sl-color-accent, var(--primary));
    font-weight: 600;
    padding: 0;
  }

  .env-default {
    color: var(--muted-foreground);
  }

  .env-default code {
    background: transparent;
    color: var(--foreground);
    padding: 0;
  }

  .env-required {
    color: oklch(0.55 0.18 25);
    font-size: 0.7em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :root[data-theme="dark"] .env-required {
    color: oklch(0.75 0.18 25);
  }
</style>
